# =============================================================================
# CONFIGURATION LOCALE : TRADING BOT (AI INFRASTRUCTURE, POWER, ROBOTICS)
# =============================================================================
# Copiez ce fichier vers .env et renseignez vos clés réelles :
#   cp .env.example .env

# 1. Google AI Studio (Gemini) - Obligatoire pour le Tier 2
# Obtenir sur : https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY="AIzaSy..."

# Stratégie de modèle hybride (Économie de crédits) :
#   - GEMINI_MODEL="gemini-2.5-flash" : Routine quotidienne gratuite à 0$
#   - GEMINI_MODEL="gemini-2.5-pro"   : Raisonnement maximal
#   - AUTO_ESCALATE_TO_PRO="true"     : Flash surveille, escalade sur Pro si rotation BUY/EXIT détectée !
GEMINI_MODEL="gemini-2.5-flash"
AUTO_ESCALATE_TO_PRO="true"

# 2. Alpaca Paper Trading - Obligatoire pour le Tier 3
# Obtenir sur : https://alpaca.markets -> Dashboard -> Paper Trading -> "Generate New Keys"
APCA_API_KEY_ID="PK..."
APCA_API_SECRET_KEY="..."
APCA_API_BASE_URL="https://paper-api.alpaca.markets"

# 3. Moteur de Recherche Synthétique (Optionnel)
# Obtenir sur : https://tavily.com (1 000 requêtes gratuites/mois)
TAVILY_API_KEY="tvly-..."

# 4. Identification SEC EDGAR (Recommandé pour requêtes officielles 10-K / 10-Q)
SEC_EDGAR_IDENTITY="UserAgent: AntigravityBot admin@quantportfolio.internal"
